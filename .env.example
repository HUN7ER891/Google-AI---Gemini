# AI Studio template names, retained for reference.
# Neither is read by the current application; no API key is needed for its
# implemented Open-Meteo requests. Never expose a future secret in client code.
GEMINI_API_KEY=
APP_URL=

# Optional process environment setting used by vite.config.ts.
# Set DISABLE_HMR=true in the shell environment to disable HMR and file watching.
# This file is an example; vite.config.ts does not explicitly load it.
DISABLE_HMR=
